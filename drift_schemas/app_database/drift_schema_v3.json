  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE COLLATE NOCASE, \"type\" TEXT NOT NULL, \"opening_balance_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL DEFAULT 'PHP', \"created_at\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), CHECK (length(name) BETWEEN 1 AND 40), CHECK ((type = 'savingsCash' AND opening_balance_minor >= 0) OR (type IN ('credit', 'loan') AND opening_balance_minor <= 0)));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE COLLATE NOCASE, \"kind\" TEXT NOT NULL, CHECK (length(name) BETWEEN 1 AND 40), CHECK (kind IN ('spending', 'inflow')));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"payee\" TEXT NOT NULL DEFAULT '', \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE RESTRICT, \"source_account_id\" INTEGER NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"destination_account_id\" INTEGER NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"note\" TEXT NOT NULL DEFAULT '', \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, CHECK (amount_minor > 0), CHECK (source_account_id <> destination_account_id), CHECK (date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), CHECK (length(payee) <= 60), CHECK (length(note) <= 500), CHECK ((type = 'spending' AND source_account_id IS NOT NULL AND destination_account_id IS NULL AND category_id IS NOT NULL) OR (type = 'inflow' AND source_account_id IS NULL AND destination_account_id IS NOT NULL) OR (type IN ('transfer', 'creditCardPayment') AND source_account_id IS NOT NULL AND destination_account_id IS NOT NULL AND category_id IS NULL)));"
        }
      ]
    },
