          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_account_types\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE COLLATE NOCASE, \"base_type\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, CHECK (length(name) BETWEEN 1 AND 40), CHECK (base_type IN ('savingsCash', 'credit', 'loan')));"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE COLLATE NOCASE, \"type\" TEXT NOT NULL, \"opening_balance_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL DEFAULT 'PHP', \"created_at\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"custom_type_id\" INTEGER NULL REFERENCES custom_account_types (id) ON DELETE RESTRICT, \"is_budget_account\" INTEGER NOT NULL DEFAULT 0 CHECK(NOT \"is_budget_account\" OR \"type\" = 'savingsCash') CHECK (\"is_budget_account\" IN (0, 1)), CHECK (length(name) BETWEEN 1 AND 40), CHECK ((type = 'savingsCash' AND opening_balance_minor >= 0) OR (type IN ('credit', 'loan') AND opening_balance_minor <= 0)));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE COLLATE NOCASE, \"kind\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"is_plan_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_plan_archived\" IN (0, 1)), \"is_plan_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK(\"is_plan_deleted\" = 0 OR \"is_plan_archived\" = 1 AND \"kind\" = 'spending') CHECK (\"is_plan_deleted\" IN (0, 1)), \"plan_group\" TEXT NOT NULL DEFAULT 'spending' CHECK(\"plan_group\" IN ('spending', 'savings', 'liability')), \"linked_account_id\" INTEGER NULL UNIQUE REFERENCES accounts (id) ON DELETE SET NULL, CHECK (length(name) BETWEEN 1 AND 40), CHECK (linked_account_id IS NULL OR (kind = 'spending' AND plan_group = 'liability')), CHECK (kind IN ('spending', 'inflow')));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"payee\" TEXT NOT NULL DEFAULT '', \"category_id\" INTEGER NULL REFERENCES categories (id) ON DELETE RESTRICT, \"source_account_id\" INTEGER NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"destination_account_id\" INTEGER NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"note\" TEXT NOT NULL DEFAULT '', \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, CHECK (amount_minor > 0), CHECK (source_account_id <> destination_account_id), CHECK (date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), CHECK (length(payee) <= 60), CHECK (length(note) <= 500), CHECK ((type = 'spending' AND source_account_id IS NOT NULL AND destination_account_id IS NULL AND category_id IS NOT NULL) OR (type = 'inflow' AND source_account_id IS NULL AND destination_account_id IS NOT NULL) OR (type IN ('transfer', 'creditCardPayment') AND source_account_id IS NOT NULL AND destination_account_id IS NOT NULL AND category_id IS NULL)));"
        }
      ]
    },
    {
      "name": "monthly_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"monthly_plans\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"month\" TEXT NOT NULL, \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE CASCADE, \"target_amount_minor\" INTEGER NULL, \"assigned_amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, UNIQUE (\"month\", \"category_id\"), CHECK (target_amount_minor IS NULL OR target_amount_minor >= 0), CHECK (assigned_amount_minor >= 0), CHECK (month GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]' AND substr(month, 6, 2) BETWEEN '01' AND '12'));"
        }
      ]
    },
    {
      "name": "accounts_one_budget_account",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX accounts_one_budget_account ON accounts (is_budget_account) WHERE is_budget_account = 1"
        }
      ]
    },
    {
      "name": "transactions_date",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX transactions_date ON transactions (date)"
        }
      ]
    },
    {
      "name": "transactions_source_account",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX transactions_source_account ON transactions (source_account_id)"
        }
      ]
    },
    {
      "name": "transactions_destination_account",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX transactions_destination_account ON transactions (destination_account_id)"
        }
      ]
    }
