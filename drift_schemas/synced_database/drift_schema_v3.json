      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"opening_balance_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL CHECK (\"is_archived\" IN (0, 1)), \"custom_type_id\" TEXT NULL, \"is_budget_account\" INTEGER NOT NULL CHECK (\"is_budget_account\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK ((type = 'savingsCash' AND opening_balance_minor >= 0) OR (type IN ('credit', 'loan') AND opening_balance_minor <= 0)), CHECK (currency_code = 'PHP'), CHECK (NOT is_budget_account OR (type = 'savingsCash' AND NOT is_archived)), CHECK (revision > 0));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL CHECK (\"is_archived\" IN (0, 1)), \"is_plan_archived\" INTEGER NOT NULL CHECK (\"is_plan_archived\" IN (0, 1)), \"is_plan_deleted\" INTEGER NOT NULL CHECK (\"is_plan_deleted\" IN (0, 1)), \"plan_group\" TEXT NOT NULL, \"linked_account_id\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (kind IN ('spending', 'inflow')), CHECK (plan_group IN ('spending', 'savings', 'liability')), CHECK (NOT is_plan_deleted OR (is_plan_archived AND kind = 'spending')), CHECK (linked_account_id IS NULL OR (kind = 'spending' AND plan_group = 'liability')), CHECK (revision > 0));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency_code\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"payee\" TEXT NOT NULL, \"category_id\" TEXT NULL, \"source_account_id\" TEXT NULL, \"destination_account_id\" TEXT NULL, \"note\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (type IN ('spending', 'inflow', 'transfer', 'creditCardPayment')), CHECK (amount_minor > 0), CHECK (currency_code = 'PHP'), CHECK (source_account_id <> destination_account_id), CHECK (revision > 0));"
        }
